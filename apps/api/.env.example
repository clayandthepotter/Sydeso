# Port the API listens on.
PORT=4000

# Database, read by Prisma. See packages/db/.env.example for the Supabase form.
DATABASE_URL="postgresql://sydeso:sydeso@localhost:5432/sydeso"
DIRECT_URL="postgresql://sydeso:sydeso@localhost:5432/sydeso"

# Origins allowed to call the API from a browser with credentials, comma separated.
WEB_ORIGIN=http://localhost:3000

# How long a session stays valid after its last use, and how long an invite link lives.
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
