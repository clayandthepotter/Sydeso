# Port the API listens on.
PORT=4000

# Database, read by Prisma. See packages/db/.env.example for the Supabase form.
DATABASE_URL="postgresql://sydeso:sydeso@localhost:5432/sydeso"
DIRECT_URL="postgresql://sydeso:sydeso@localhost:5432/sydeso"

# Origins allowed to call the API from a browser with credentials, comma separated.
WEB_ORIGIN=http://localhost:3000

# How long a session stays valid after its last use, and how long an invite link lives.
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7

# S3-compatible object storage for large artifacts (MinIO from infra/docker locally).
# Leave the keys unset to run without storage; inline JSON artifacts still work.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sydeso-artifacts
STORAGE_ACCESS_KEY_ID=minio
STORAGE_SECRET_ACCESS_KEY=miniosecret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=52428800
