{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sydeso-app",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // The product lives at app.sydeso.com; Cloudflare creates the DNS record on deploy.
  "routes": [{ "pattern": "app.sydeso.com", "custom_domain": true }],
  // Server-side only: the Worker calls the API, browsers never do.
  "vars": { "SYDESO_API_URL": "https://api.sydeso.com/api/v1" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
