{
  "name": "sydeso",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @sydeso/db generate",
    "db:migrate": "pnpm --filter @sydeso/db migrate",
    "format": "prettier --write .",
    "project:sync:labels": "node .github/project/scripts/sync-labels.mjs",
    "project:sync:project": "node .github/project/scripts/sync-project.mjs",
    "project:sync:issues": "node .github/project/scripts/sync-issues.mjs",
    "project:roadmap": "node .github/project/scripts/generate-roadmap.mjs",
    "project:wiki": "node .github/project/scripts/wiki-publish.mjs",
    "release:semantic": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^26.1.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "js-yaml": "^5.2.3",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}
