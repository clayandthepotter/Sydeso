generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkflowState {
  backlog
  design
  design_approval
  development
  automated_qa
  manual_review
  ready
  released
  escalated
}

enum ActorType {
  user
  agent
  system
  runner
}

enum JobStatus {
  queued
  assigned
  running
  succeeded
  failed
  cancelled
}

enum ArtifactType {
  feature_request
  prd
  research_report
  design_package
  implementation_package
  qa_report
  review_report
  release_candidate
  skill_file
  workflow_template
  policy_definition
}

enum RunnerType {
  self_hosted
  managed
}

enum RunnerStatus {
  online
  offline
  busy
  disabled
}

/// MVP roles from docs/product/roles-and-permissions.md. The permission matrix lives in @sydeso/domain.
enum OrganizationRole {
  owner
  admin
  product_manager
  engineer
  reviewer
  viewer
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  passwordHash    String
  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[] @relation("InvitationInviter")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// A browser or CLI session. Only the hash of the bearer token is stored.
model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// A user's role inside one organization. Permissions inherit downward to workspaces and projects.
model Membership {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

/// An invitation to join an organization with a role. The link carries a token; only its hash is stored.
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  invitedById    String
  invitedBy      User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, email])
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  plan        String       @default("builder")
  memberships Membership[]
  invitations Invitation[]
  workspaces  Workspace[]
  projects    Project[]
  runners     Runner[]
  artifacts   Artifact[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([organizationId, slug])
}

model Project {
  id                         String       @id @default(uuid())
  organizationId             String
  workspaceId                String
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace                  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                       String
  repositoryUrl              String?
  defaultBranch              String       @default("main")
  maxRemediationIterations   Int          @default(3)
  archivedAt                 DateTime?
  features                   Feature[]
  artifacts                  Artifact[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @default(now()) @updatedAt
}

model Feature {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String
  status         WorkflowState @default(backlog)
  workflowRuns   WorkflowRun[]
  artifacts      Artifact[]
  createdAt      DateTime      @default(now())
}

model WorkflowRun {
  id                String        @id @default(uuid())
  organizationId    String
  featureId         String
  feature           Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  currentState      WorkflowState @default(backlog)
  status            String        @default("active")
  remediationCount  Int           @default(0)
  jobs              Job[]
  transitions       WorkflowTransition[]
  artifacts         Artifact[]
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
}

model WorkflowTransition {
  id                String        @id @default(uuid())
  organizationId    String
  workflowRunId     String
  workflowRun       WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  fromState         WorkflowState?
  toState           WorkflowState
  triggeredByType   ActorType
  triggeredById     String?
  reason            String?
  metadata          Json          @default("{}")
  createdAt         DateTime      @default(now())
}

model Job {
  id                    String        @id @default(uuid())
  organizationId        String
  workflowRunId         String
  workflowRun           WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  state                 WorkflowState
  agentType             String
  requiredCapabilities  String[]      @default([])
  status                JobStatus     @default(queued)
  runnerId              String?
  runner                Runner?       @relation(fields: [runnerId], references: [id])
  inputArtifactIds      String[]      @default([])
  outputArtifactIds     String[]      @default([])
  producedArtifacts     Artifact[]    @relation("JobOutputs")
  attempt               Int           @default(1)
  error                 Json?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())

  @@index([organizationId, status])
  @@index([runnerId])
}

/// The system of record. Rows are immutable: a database trigger rejects UPDATE, and a new
/// version is a new row. Small content lives inline as JSON; large content lives in object
/// storage under storageKey, with the SHA-256 of the bytes in checksum either way.
model Artifact {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId         String?
  feature           Feature?      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  workflowRunId     String?
  workflowRun       WorkflowRun?  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  type              ArtifactType
  version           Int
  title             String
  content           Json?
  storageKey        String?
  contentType       String?
  sizeBytes         Int?
  checksum          String
  /// lineage: the artifacts this one was produced from, and the job that produced it
  sourceArtifactIds String[]      @default([])
  producedByJobId   String?
  producedByJob     Job?          @relation("JobOutputs", fields: [producedByJobId], references: [id], onDelete: SetNull)
  metadata          Json          @default("{}")
  createdByType     ActorType
  createdById       String?
  createdAt         DateTime      @default(now())

  @@unique([featureId, type, version])
  @@index([workflowRunId, type])
  @@index([projectId, createdAt])
  @@index([producedByJobId])
}

model Runner {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            RunnerType
  status          RunnerStatus  @default(offline)
  version         String
  capabilities    String[]      @default([])
  tokenHash       String        @unique
  healthMetrics   Json          @default("{}")
  lastSeenAt      DateTime?
  jobs            Job[]
  createdAt       DateTime      @default(now())

  @@index([organizationId, status])
}

model AuditLog {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType       ActorType
  actorId         String?
  action          String
  entityType      String
  entityId        String?
  before          Json?
  after           Json?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model WaitlistLead {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String?
  useCase   String?
  source    String   @default("marketing_site")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
