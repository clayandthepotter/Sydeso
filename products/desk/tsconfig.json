{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "features/**/*.ts",
    "vitest.config.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "apps/web/src/browser/**"
  ]
}
