{
  // desk-planner. Reads desk-planner-inbox. Creates Linear issues.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "desk-planner",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "desk-events", "database_id": "32c0de8b-d44a-413c-a30d-e65246d13974" }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "desk-planner-inbox",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "desk-planner-dlq"
      }
    ],
    "producers": [{ "binding": "TRIAGE_QUEUE", "queue": "desk-triage-inbox" }]
  },
  // Secret: DESK_SECRETS_KEY. The same value as on desk-api.
  "observability": { "enabled": true }
}
