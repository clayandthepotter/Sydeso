{
  // desk-api. Serves the Desk PWA and the API at desk.sydeso.com.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "desk-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "desk.sydeso.com", "custom_domain": true }],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desk-events",
      "database_id": "DESK_EVENTS_DATABASE_ID",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "desk-raw" }],
  "ratelimits": [{ "name": "AUTH_RATE_LIMITER", "namespace_id": "1701", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "APP_ORIGIN": "https://desk.sydeso.com",
    "RP_ID": "desk.sydeso.com",
    "RP_NAME": "Desk",
    "SESSION_TTL_DAYS": "30",
    "CHALLENGE_TTL_MINUTES": "5",
    "DEFAULT_CONFIDENCE_THRESHOLD": "0.7"
  },
  "observability": { "enabled": true }
}
